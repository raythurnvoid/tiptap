{
  "name": "@tiptap/core",
  "description": "headless rich text editor",
  "version": "3.8.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "headless",
    "wysiwyg",
    "text editor",
    "prosemirror"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "dist",
    "jsx-runtime",
    "jsx-dev-runtime"
  ],
  "devDependencies": {
    "@tiptap/pm": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
