{
  "name": "@tiptap/extension-list",
  "description": "List extension for tiptap",
  "version": "3.8.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bullet-list": "./src/bullet-list/index.ts",
    "./item": "./src/item/index.ts",
    "./keymap": "./src/keymap/index.ts",
    "./kit": "./src/kit/index.ts",
    "./ordered-list": "./src/ordered-list/index.ts",
    "./task-item": "./src/task-item/index.ts",
    "./task-list": "./src/task-list/index.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-list"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
