{
  "name": "@tiptap/extension-text-style",
  "description": "text style extension for tiptap",
  "version": "3.8.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./background-color": "./src/background-color/index.ts",
    "./color": "./src/color/index.ts",
    "./font-family": "./src/font-family/index.ts",
    "./font-size": "./src/font-size/index.ts",
    "./line-height": "./src/line-height/index.ts",
    "./text-style": "./src/text-style/index.ts",
    "./text-style-kit": "./src/text-style-kit/index.ts"
