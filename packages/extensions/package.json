{
  "name": "@tiptap/extensions",
  "description": "various extensions for tiptap",
  "version": "3.8.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./character-count": "./src/character-count/index.ts",
    "./drop-cursor": "./src/drop-cursor/index.ts",
    "./focus": "./src/focus/index.ts",
    "./gap-cursor": "./src/gap-cursor/index.ts",
    "./undo-redo": "./src/undo-redo/index.ts",
    "./placeholder": "./src/placeholder/index.ts",
    "./selection": "./src/selection/index.ts",
    "./trailing-node": "./src/trailing-node/index.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^"
  },
  "peerDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
