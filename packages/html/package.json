{
  "name": "@tiptap/html",
  "description": "utility package to render tiptap JSON as HTML",
  "version": "3.8.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap utility"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^",
    "linkedom": "^0.18.12"
  },
  "peerDependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^",
    "linkedom": "^0.18.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/html"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
